  early-commands:
    - mdadm -S /dev/md* || true
    - mdadm --zero-superblock /dev/sda || true
    - mdadm --zero-superblock /dev/sdb || true
    - mdadm --zero-superblock /dev/nvme0n1 || true
    - mdadm --zero-superblock /dev/nvme1n1 || true
    - lvremove /dev/ubuntu-vg/ubuntu-lv -f || true
    - vgremove ubuntu-vg || true
    - |
      # 在安装器(源)环境装 ipmitool，用于读 BMC IP。扁平 debs：优先 apt 本地源解依赖，失败回退 dpkg
      echo "deb [trusted=yes] file:/cdrom/debs ./" > /etc/apt/sources.list.d/offline-cdrom.list
      apt-get update || true
      apt-get install -y --no-install-recommends ipmitool || dpkg -i /cdrom/debs/ipmitool_*.deb || true
