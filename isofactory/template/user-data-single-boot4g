    ethernets:
      all:
        match:
          name: "en*"
        dhcp4: true
  # 是否安装第三方驱动
  drivers:
    install: false
  # 内核安装，linux-generic 通用内核
  kernel:
    package: linux-generic
  # 设置存储库，这里使用阿里云
