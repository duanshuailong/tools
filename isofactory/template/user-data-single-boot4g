      echo "[1/4] 正在将带外模式修改为静态 (Static)..."
      ipmitool lan set 1 ipsrc static || { echo "错误: 修改静态模式失败！"; exit 1; }
      echo "等待 5 秒让 BMC 响应..."
      sleep 5

      # 2. 配置网络参数（每一步后都强制等待 5 秒，防止 BMC 芯片高并发下漏指令）
      echo "[2/4] 正在配置网络参数 (IP: $IPMI_IP)..."
      ipmitool lan set 1 ipaddr "$IPMI_IP"
      echo "IP 写入中，等待 5 秒..."
      sleep 5

      ipmitool lan set 1 netmask "$IPMI_NETMASK"
      echo "掩码 写入中，等待 5 秒..."
      sleep 5

      ipmitool lan set 1 defgw ipaddr "$IPMI_GATEWAY"
      echo "网关 写入中，等待 5 秒..."
      sleep 5

      # 3. 修改第二个用户的密码
      echo "[3/4] 正在修改第二个用户的密码..."
      ipmitool user set password "$USER_ID" "$NEW_PASSWORD" || { echo "错误: 修改密码失败！"; exit 1; }
      echo "密码 写入中，等待 5 秒..."
      sleep 5

      # 4. 读取当前 BMC 状态并进行最终校验
      echo "[4/4] 正在进行最终状态校验..."

      # 获取当前的局域网配置信息
      LAN_INFO=$(ipmitool lan print 1)

      # 定义校验函数，找不到匹配项就报错退出
      check_config() {
          local keyword="$1"
          local expected_value="$2"
          if ! echo "$LAN_INFO" | grep -F "$keyword" | grep -q "$expected_value"; then
              echo "校验失败: $keyword 未能成功配置为 $expected_value !"
              echo "当前 BMC 状态如下:"
              echo "$LAN_INFO" | grep -E "IP Address|Subnet Mask|Default Gateway|IP Address Source"
              exit 1
          fi
      }

      # 开始逐项比对
      check_config "IP Address Source" "Static"
      check_config "IP Address  " "$IPMI_IP"       # 注意: ipmitool 输出中 IP Address 后面有两个空格
      check_config "Subnet Mask" "$IPMI_NETMASK"
      check_config "Default Gateway IP" "$IPMI_GATEWAY"

      echo "所有网络配置校验通过！"

      # 5. 执行 BMC 冷重启
      echo "正在对 BMC (带外) 执行冷重启..."
      ipmitool mc reset cold

      echo "----------------------------------------"
      echo "IPMI 配置及校验成功！BMC 正在重启，请等待 1-2 分钟后尝试连接。"
      echo "----------------------------------------"
      PYIPMI
