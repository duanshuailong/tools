      #!/usr/bin/env python3
      """Generate management-network udev rules for dual-port CX5/CX6 and USB NIC disable."""

      from __future__ import annotations

      import argparse
      import re
      import subprocess
      import sys
      from pathlib import Path


      def run(cmd: list[str]) -> str:
          proc = subprocess.run(cmd, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
          if proc.returncode != 0:
              raise RuntimeError(f"{' '.join(cmd)} failed: {proc.stderr.strip()}")
          return proc.stdout


      def bdf_for_netdev(name: str) -> str | None:
          device = Path("/sys/class/net") / name / "device"
          try:
              return device.resolve().name
          except FileNotFoundError:
              return None


      def discover_base_from_netplan() -> str | None:
          netplan_dir = Path("/etc/netplan")
          for path in sorted(list(netplan_dir.glob("*.yaml")) + list(netplan_dir.glob("*.yml"))):
              text = path.read_text(errors="ignore")
              if "to: default" not in text:
                  continue
              for match in re.finditer(r"interfaces:\s*\[([^\]]+)\]", text):
                  names = [item.strip().strip("'\"") for item in match.group(1).split(",")]
                  bdfs = [bdf_for_netdev(name) for name in names]
                  bdfs = [bdf for bdf in bdfs if bdf]
                  bases: dict[str, set[str]] = {}
                  for bdf in bdfs:
                      bdf_match = re.match(r"^(.+)\.([01])$", bdf)
                      if bdf_match:
                          bases.setdefault(bdf_match.group(1), set()).add(bdf_match.group(2))
                  for base, funcs in sorted(bases.items()):
                      if {"0", "1"} <= funcs:
                          return base
          return None


      def discover_base() -> str:
          netplan_base = discover_base_from_netplan()
          if netplan_base:
              return netplan_base

          groups: dict[str, set[str]] = {}
          output = run(["lspci", "-D"])
          for line in output.splitlines():
              if "Mellanox" not in line:
                  continue
              if not ("ConnectX-5" in line or "ConnectX-6" in line or "CX5" in line or "CX6" in line):
                  continue
              bdf = line.split()[0]
              match = re.match(r"^(.+)\.([01])$", bdf)
              if not match:
                  continue
              groups.setdefault(match.group(1), set()).add(match.group(2))

          candidates = sorted(base for base, funcs in groups.items() if {"0", "1"} <= funcs)
          if not candidates:
              raise RuntimeError("no dual-port ConnectX-5/ConnectX-6 pair found")
          return candidates[0]


      def generate_rules(base: str, usb_name: str, usb_mac: str | None) -> str:
          disable_cmd = "/usr/local/sbin/doca-disable-usb-netdev.sh %k"
          lines = [
              "# =============================================================================",
              "# 81-management-net.rules",
              "# Generated management-network names.",
              "# =============================================================================",
              "",
              f'ACTION=="add", KERNELS=="{base}.0", SUBSYSTEM=="net", NAME="eth0"',
              f'ACTION=="add", KERNELS=="{base}.1", SUBSYSTEM=="net", NAME="eth1"',
              "",
              "# Hide USB management adapters from the OS by unbinding their net driver.",
              f'ACTION=="add", SUBSYSTEM=="net", KERNEL=="enx*", RUN+="{disable_cmd}"',
              f'ACTION=="add", SUBSYSTEM=="net", KERNEL=="{usb_name}", RUN+="{disable_cmd}"',
          ]
          if usb_mac:
              lines.append(
                  f'ACTION=="add", SUBSYSTEM=="net", ATTR{{address}}=="{usb_mac}", RUN+="{disable_cmd}"'
              )
          return "\n".join(lines)


      def main() -> int:
          parser = argparse.ArgumentParser()
          parser.add_argument("-o", "--output", default="/etc/udev/rules.d/81-management-net.rules")
          parser.add_argument("--base-bdf", help="BDF prefix without function, for example 0001:8b:00")
          parser.add_argument("--usb-name", default="enx928a311d8f2e")
          parser.add_argument("--usb-mac", default="92:8a:31:1d:8f:2e")
          args = parser.parse_args()

          base = args.base_bdf or discover_base()
          rules = generate_rules(base, args.usb_name, args.usb_mac)

          if args.output == "-":
              print(rules)
          else:
              output = Path(args.output)
              desired = rules + "\n"
              if output.exists() and output.read_text() == desired:
                  print(f"OK {args.output} already up to date")
              else:
                  output.write_text(desired)
                  print(f"CHANGED written {args.output}")
              print(f"eth0 -> {base}.0")
              print(f"eth1 -> {base}.1")
          return 0


      if __name__ == "__main__":
          try:
              raise SystemExit(main())
          except Exception as exc:
              print(f"ERROR: {exc}", file=sys.stderr)
              raise SystemExit(1)
      PYEOF
