      #echo $LAST_OCTET > /last.log
      #HOSTI=$((LAST_OCTET+1000))
      sed -i "s/HOSTIP_1/${LAST_OCTET}/g" /autoinstall.yaml
      sed -i "s/HOSTNAME_1/${LAST_OCTET}/g" /autoinstall.yaml
    # ══════════════════════════════════════════════════════════════════
    # 第一步：枚举并选择目标盘（300G–2000G，排除 U 盘和安装介质）
    # 按总线类型分组（不用 ROTA：SATA SSD 的 ROTA=0，会被误判成 NVMe）
    #   SATA/SAS/SCSI → /dev/sdX + 分区 sdXN
    #   NVMe          → /dev/nvmeXn1 + 分区 nvmeXn1pN
    # 优先级：2 块同容量 SATA/SAS > 2 块同容量 NVMe（不混组 RAID）
    # 选中的盘写入 /run/target-disks.txt，每行一个真实路径
    # ══════════════════════════════════════════════════════════════════
    - |
      # set -e
      MIN_GB=300
      MAX_GB=2000
      NEED=1
      LOG()  { echo "[disk-select] $*"; }
      FAIL() { echo "[disk-select] ERROR: $*" >&2; exit 1; }

      # 检查安装介质：ISO/VFAT/UDF
      is_install_media() {
        blkid "$1" 2>/dev/null | grep -qE "iso9660|udf|vfat"
      }

      # 按 TRAN 识别，TRAN 为空时回退到设备名
      # sata/sas/ata/scsi → sata（分区名 /dev/sdX1）
      # nvme              → nvme（分区名 /dev/nvmeXn1p1）
      disk_kind() {
        local name=$1 tran=$2
        case "$tran" in
          nvme) echo nvme; return ;;
          sata|sas|ata|scsi) echo sata; return ;;
        esac
        case "$name" in
          nvme*) echo nvme ;;
          sd*)   echo sata ;;
          *)     echo unknown ;;
        esac
      }

      LOG "===== 第一步：选择目标硬盘 ====="

      > /run/target-disks.txt
      > /run/disk-candidates.txt
      > /run/disk-sata.txt
      > /run/disk-nvme.txt

      # 逐行枚举所有裸盘（写入临时文件，避免管道子 shell）
      # 字段: NAME SIZE RM TRAN
      lsblk -d --bytes --noheadings -o NAME,SIZE,RM,TRAN 2>/dev/null > /run/lsblk-disks.txt
      while read -r name size_b rm tran; do
        [ -z "$name" ] && continue
        dev="/dev/$name"
        [ -b "$dev" ] || continue

        # ── 过滤条件 ──
        # 1. 排除可移动设备（U 盘/移动硬盘）
        [ "$rm" = "1" ] && LOG "  排除 (可移动): $dev" && continue
        # 2. 排除 USB 总线设备
        [ "$tran" = "usb" ] && LOG "  排除 (USB): $dev" && continue
        # 3. 排除安装介质（ISO/VFAT/UDF）
        if is_install_media "$dev"; then
          LOG "  排除 (安装介质): $dev"
          continue
        fi
        # 4. 容量过滤
        size_gb=${size_b:-0}
        size_gb=$(( size_gb / 1024 / 1024 / 1024 )) 2>/dev/null || size_gb=0
        if [ "$size_gb" -lt "$MIN_GB" ] || [ "$size_gb" -gt "$MAX_GB" ]; then
          LOG "  排除 (容量 ${size_gb}G 不在 ${MIN_GB}G-${MAX_GB}G): $dev"
          continue
        fi

        kind=$(disk_kind "$name" "$tran")
        if [ "$kind" = "unknown" ]; then
          LOG "  排除 (无法识别总线): $dev  tran=$tran"
          continue
        fi

        LOG "  可用: $dev  容量=${size_gb}G  kind=$kind  tran=$tran"
        echo "$dev|$size_gb|$kind|$tran" >> /run/disk-candidates.txt
        if [ "$kind" = "sata" ]; then
          echo "$dev|$size_gb|$kind|$tran" >> /run/disk-sata.txt
        else
          echo "$dev|$size_gb|$kind|$tran" >> /run/disk-nvme.txt
        fi
      done < /run/lsblk-disks.txt

      # 从分组中取「同容量、数量 >= NEED」的最大容量组
      pick_same_size() {
        local group_file=$1
        local size_gb
        [ -s "$group_file" ] || return 1
        size_gb=$(cut -d'|' -f2 "$group_file" | sort -n | uniq -c | \
                  awk -v n="$NEED" '$1 >= n {print $2}' | sort -n | tail -1)
        [ -z "$size_gb" ] && return 1
        grep "|${size_gb}|" "$group_file" | head -n "$NEED"
      }

      write_targets() {
        local label=$1
        local lines=$2
        > /run/target-disks.txt
        printf '%s\n' "$lines" > /run/pick-lines.txt
        while read -r line; do
          [ -z "$line" ] && continue
          disk=$(echo "$line" | cut -d'|' -f1)
          size_gb=$(echo "$line" | cut -d'|' -f2)
          LOG "选中 ${label} ${size_gb}G: $disk"
          echo "$disk" >> /run/target-disks.txt
        done < /run/pick-lines.txt
      }

      target_sata=$(pick_same_size /run/disk-sata.txt || true)
      target_nvme=$(pick_same_size /run/disk-nvme.txt || true)

      if [ -n "$target_sata" ]; then
        write_targets "SATA/SAS" "$target_sata"
      elif [ -n "$target_nvme" ]; then
        write_targets "NVMe" "$target_nvme"
      fi

      disk_count=$(wc -l < /run/target-disks.txt 2>/dev/null || echo 0)
      disk_count=$(echo "$disk_count" | tr -d ' ')
      [ -z "$disk_count" ] && disk_count=0
      [ "$disk_count" -lt "$NEED" ] && FAIL "未找到符合条件（${MIN_GB}G-${MAX_GB}G）的 SATA/SAS 或 NVMe 硬盘"

      LOG "===== 选中的目标硬盘 ====="
      while read -r disk; do
        [ -z "$disk" ] && continue
        size_b=$(lsblk -bdn -o SIZE "$disk" 2>/dev/null || echo 0)
        size_gb=$(( size_b / 1024 / 1024 / 1024 )) 2>/dev/null || size_gb=0
        name=$(basename "$disk")
        tran=$(lsblk -dn -o TRAN "$disk" 2>/dev/null || true)
        kind=$(disk_kind "$name" "$tran")
        LOG "  $disk  ${size_gb}G  $kind  tran=$tran"
      done < /run/target-disks.txt
      LOG "========================================="

    # ══════════════════════════════════════════════════════════════════
    # 第二步：清除选中盘上所有 RAID 痕迹
    # ══════════════════════════════════════════════════════════════════
    - |
      # set -e
      LOG()  { echo "[raid-clean-disk] $*"; }
      FAIL() { echo "[raid-clean-disk] ERROR: $*" >&2; exit 1; }

      [ -f /run/target-disks.txt ] || FAIL "/run/target-disks.txt 不存在"
      disk_count=$(wc -l < /run/target-disks.txt 2>/dev/null || echo 0)
      [ "$disk_count" -lt 1 ] && FAIL "未选到目标硬盘（需至少 1 块）"

      LOG "===== 第二步：清除选中盘的 RAID 痕迹 ====="

      while read -r disk; do
        [ -z "$disk" ] && continue
        [ -b "$disk" ] || { LOG "  $disk 不存在，跳过"; continue; }

        LOG "处理 $disk ..."

        # ── 停止该盘分区参与的 md 阵列 ──
        for part in "$disk" "${disk}"[0-9]* "${disk}p"[0-9]*; do
          [ -b "$part" ] || continue
          # 检查是否属于某个 md（从 /proc/mdstat 找设备名）
          md_assoc=$(grep -E "$(basename "$part")$" /proc/mdstat 2>/dev/null | awk '{print $1}' | head -1 || true)
          if [ -n "$md_assoc" ] && [ -b "/dev/$md_assoc" ]; then
            LOG "  停止 $disk 上的 RAID /dev/$md_assoc ..."
            mdadm --stop "/dev/$md_assoc" 2>/dev/null || true
          fi
        done

        # ── 逐分区清 superblock ──
        for part in "$disk" "${disk}"[0-9]* "${disk}p"[0-9]*; do
          [ -b "$part" ] || continue
          if mdadm --examine "$part" 2>/dev/null | grep -q "Linux.*raid"; then
            LOG "  清 superblock: $part"
            mdadm --zero-superblock "$part" 2>/dev/null || true
          fi
        done

        # ── 刷新分区表 ──
        LOG "  刷新分区表: $disk"
        partprobe "$disk" 2>/dev/null || true
        LOG "  $disk 清完毕"
      done < /run/target-disks.txt

      LOG "========================================="

    # ══════════════════════════════════════════════════════════════════
    # 第三步：清理 md0 / md1（若有其他 RAID 占用了这两个名称，全部清掉）
    # ══════════════════════════════════════════════════════════════════
    - |
      # set -e
      LOG()  { echo "[raid-clean-md] $*"; }

      LOG "===== 第三步：清理 md0 / md1 ====="

      for md in /dev/md0 /dev/md1; do
        if [ ! -b "$md" ]; then
          LOG "  $md 不存在，跳过"
          continue
        fi

        LOG "  发现 $md 存在，清空中 RAID ..."
        members=$(mdadm --detail "$md" 2>/dev/null | \
                   awk '/\/dev\// && !/^\/dev\/md/ {print $NF}' || true)
        [ -n "$members" ] && LOG "    成员盘: $members"

        mdadm --stop "$md" 2>/dev/null || true

        for member in $members; do
          if [ -b "$member" ]; then
            LOG "    清 superblock: $member"
            mdadm --zero-superblock "$member" 2>/dev/null || true
          fi
        done

        # 强制 kernel 释放 md 编号
        mdn=$(basename "$md")
        echo "idle" > "/sys/block/$mdn/md/array_state" 2>/dev/null || true
        LOG "  $md 清完毕"
      done

      # 全局扫描：300G-2000G 非安装介质的盘，是否还有 md 残留
      lsblk -d --bytes --noheadings -o NAME,SIZE 2>/dev/null | while read -r name size_b; do
        [ -z "$name" ] && continue
        dev="/dev/$name"
        size_gb=${size_b:-0}
        size_gb=$(( size_gb / 1024 / 1024 / 1024 )) 2>/dev/null || continue
        [ "$size_gb" -lt 300 ] || [ "$size_gb" -gt 2000 ] && continue
        blkid "$dev" 2>/dev/null | grep -qE "iso9660|vfat|udf" && continue
        for part in "$dev" "${dev}"[0-9]* "${dev}p"[0-9]*; do
          [ -b "$part" ] || continue
          if grep -q "$(basename "$part")" /proc/mdstat 2>/dev/null; then
            mdname=$(grep "$(basename "$part")" /proc/mdstat | awk '{print $1}' | head -1 || true)
            if [ -n "$mdname" ] && [ -b "/dev/$mdname" ]; then
              LOG "  发现残留关联 /dev/$mdname -> $part，一并清理 ..."
              mdadm --stop "/dev/$mdname" 2>/dev/null || true
              mdadm --zero-superblock "$part" 2>/dev/null || true
            fi
          fi
        done
      done

      LOG "========================================="
      LOG "所有 RAID 清理完成，系统已就绪"
      LOG "========================================="

    # ══════════════════════════════════════════════════════════════════
    # 第四步：把 storage.config 中的 DISK0/DISK1 占位符替换为真实路径
    # ══════════════════════════════════════════════════════════════════
    - |
      # set -e
      LOG()  { echo "[storage-path] $*"; }
      FAIL() { echo "[storage-path] ERROR: $*" >&2; exit 1; }

      AUTOINSTALL="/autoinstall.yaml"
      [ -f /run/target-disks.txt ] || FAIL "/run/target-disks.txt 不存在"
      disk_count=$(wc -l < /run/target-disks.txt 2>/dev/null || echo 0)
      [ "$disk_count" -lt 1 ] && FAIL "未选到目标硬盘（需至少 1 块）"

      DISK0=$(sed -n '1p' /run/target-disks.txt)
      [ -z "$DISK0" ] && FAIL "读取目标硬盘路径失败"

      LOG "disk-sda = $DISK0"

      # 路径中含 / 和 &，必须转义；用 # 做 sed 分隔符避免与路径冲突
      DISK0_ESC=$(echo "$DISK0" | sed 's/[\/&]/\\&/g')

      sed -i "s#path: DISK0#path: $DISK0_ESC#g" "$AUTOINSTALL"
      LOG "storage.config 路径替换完成（单盘：$DISK0）"


  late-commands:
    # ssh 密钥
    - |
      curtin in-target --target=/target -- bash -c '
      mkdir -p /target/root/.ssh || true;
      echo "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPmxk5KAgGJOZBwtk8X6ketoLHY2cXNvR7Ucco1FDclM iw@infrawaves" >>/target/root/.ssh/authorized_keys
      echo "ssh-rsa  root@cpu11" >>/target/root/.ssh/authorized_keys
      echo "ssh-rsa  root@inspur" >>/target/root/.ssh/authorized_keys'
    # 允许root登录
    - curtin in-target --target=/target -- sed -i 's/^#*PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config
    # 修改 sysctl.conf arp内核参数
    - |
      curtin in-target --target=/target -- bash -c 'cat > /etc/sysctl.conf <<EOF
      net.ipv4.conf.all.rp_filter = 0
      net.ipv4.conf.default.rp_filter = 0
      net.ipv4.conf.eth2.rp_filter = 0
      net.ipv4.conf.eth3.rp_filter = 0
      net.ipv4.conf.bond0.rp_filter = 0
      net.ipv4.conf.all.arp_announce = 2
      net.ipv4.conf.all.arp_ignore = 1
      net.ipv4.conf.default.accept_source_route = 0
      net.ipv4.conf.default.arp_announce = 2
      net.ipv4.conf.default.arp_ignore = 1
      EOF'
    # ══════════════════════════════════════════════════════════════════
    # 配置本地离线 APT 源（扁平 debs/ + Packages 索引），用 apt 装包自动解依赖
    # 取代原来逐目录 dpkg -i（分目录结构已改为扁平）
    # ══════════════════════════════════════════════════════════════════
    - |
      curtin in-target --target=/target -- bash -c '
      echo "deb [trusted=yes] file:/cdrom/debs ./" > /etc/apt/sources.list.d/offline-cdrom.list
      apt-get update || true   # 本地源必成功；在线源无网时失败可忽略
      '
    # 安装「除 NVIDIA GPU 栈外」的所有离线包（system/build/net/monitor/OFED依赖…）
    # NVIDIA 相关（fabricmanager/nscq/dcgm/container-toolkit/nvlsm）留到装完驱动后再装
    - |
      curtin in-target --target=/target -- bash -c '
      ALL=$(grep "^Package: " /cdrom/debs/Packages | cut -d" " -f2 | sort -u)
      SYS=$(echo "$ALL" | grep -viE "^(nvidia-fabricmanager|nvidia-fabricmanager-dev|libnvidia-nscq.*|datacenter-gpu-manager.*|nvidia-container-toolkit.*|libnvidia-container.*|nvlsm)$")
      DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends $SYS
      '
    # 使能 lldpd
    - curtin in-target --target=/target -- systemctl enable lldpd
    # chrony 时间同步（chrony 已由上面 apt 装好），禁用 systemd-timesyncd
    - curtin in-target --target=/target -- systemctl disable systemd-timesyncd
    - curtin in-target --target=/target -- dpkg -r systemd-timesyncd || true
    # 固定内核版本
    - curtin in-target --target=/target -- apt-mark hold $(uname -r)
    # 禁用 apt 自动更新
    - |
      curtin in-target --target=/target -- bash -c 'cat > /etc/apt/apt.conf.d/10periodic <<EOF
      APT::Periodic::Update-Package-Lists "0";
      APT::Periodic::Download-Upgradeable-Packages "0";
      APT::Periodic::AutocleanInterval "0";
      APT::Periodic::Unattended-Upgrade "0";
      EOF'
    - |
      curtin in-target --target=/target -- bash -c 'cat > /etc/apt/apt.conf.d/20auto-upgrades <<EOF
      APT::Periodic::Update-Package-Lists "0";
      APT::Periodic::Download-Upgradeable-Packages "0";
