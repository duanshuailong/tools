# Mac DHCP (dnsmasq) — 改这里

# Device 名（en0/en5…），用 ./dhcp.sh detect 查看「网卡映射」表
INTERFACE=en5
# 可选：若自动解析失败，填写「网络服务」名（如 UGREEN），不要填 Hardware Port 长名
# NETWORK_SERVICE=UGREEN

SERVER_IP=10.0.0.254
NETMASK=255.255.255.0
NET_ADDRESS=10.0.0.0
RANGE_START=10.0.0.1
RANGE_END=10.0.0.200
ROUTER=10.0.0.254
DNS_SERVERS="8.8.8.8 1.1.1.1"
DOMAIN_NAME=lan
LEASE_TIME=12h
RUN_AT_LOAD=false
ENABLE_DNS=false
DNS_PORT=0
LOG_DHCP=true
